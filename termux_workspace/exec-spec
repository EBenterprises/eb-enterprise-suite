#!/usr/bin/env python3
# ==============================================================================
# Executive Spectrum - Unified Master CLI Control Utility
# EB Enterprises | Automated Terminal Environment
# ==============================================================================

import os
import sys

HOME = os.environ.get("HOME", "/data/data/com.termux/files/home")
WORKSPACE_DIR = os.path.join(HOME, "termux_workspace")

def print_help():
    print("=============================================================")
    print(" EXECUTIVE SPECTRUM - MASTER CLI UTILITY")
    print(" EB Enterprises | Automated Terminal Environment")
    print("=============================================================")
    print(" Usage: ./exec-spec <command> [args]")
    print("")
    print(" Commands:")
    print("   status       - Run the terminal status dashboard")
    print("   tui          - Launch the advanced curses TUI dashboard")
    print("   snippets     - Manage terminal snippets (list|add|get)")
    print("   vault        - Manage secure credentials (list|set|get)")
    print("   orchestrate  - Control workspace daemons (start|stop|restart)")
    print("   module       - Scaffold a new project module (<module_name>)")
    print("   plugin       - Manage or run workspace plugins (list|run)")
    print("   analytics    - Run system telemetry & analytics analyzer")
    print("   verify       - Run comprehensive system verification suite")
    print("   sync         - Force immediate Git repository sync")
    print("=============================================================")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "status":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_status.py")])
    elif cmd == "tui":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "executive_tui.py")])
    elif cmd == "snippets":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_snippets.py")] + args)
    elif cmd == "vault":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_vault.py")] + args)
    elif cmd == "orchestrate":
        os.execv("/bin/bash", ["bash", os.path.join(WORKSPACE_DIR, "workspace_master_orchestrator.sh")] + args)
    elif cmd == "module":
        os.execv("/bin/bash", ["bash", os.path.join(WORKSPACE_DIR, "new_module.sh")] + args)
    elif cmd == "plugin":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_plugins.py")] + args)
    elif cmd == "analytics":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_telemetry_analyzer.py")])
    elif cmd == "verify":
        os.execv(sys.executable, [sys.executable, os.path.join(WORKSPACE_DIR, "workspace_verify.py")])
    elif cmd == "sync":
        os.execv("/bin/bash", ["bash", os.path.join(WORKSPACE_DIR, "workspace_backup_sync.sh")])
    else:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
