#!/bin/bash
APP_NAME="$1"

if [ -z "$APP_NAME" ]; then
  echo "Usage: start <appname>"
  exit 1
fi

case "$APP_NAME" in
  "modular-messaging-app" | "messaging" | "chat")
    DIR="$HOME/modular-messaging-app"
    if [ ! -d "$DIR" ]; then
      DIR="./modular-messaging-app"
    fi
    if [ -d "$DIR" ]; then
      echo "Clearing process on port 3000..."
      fuser -k 3000/tcp 2>/dev/null || pkill -f "ts-node" 2>/dev/null
      sleep 1
      echo "Starting Modular Messaging App..."
      cd "$DIR" && npm run dev
    else
      echo "Error: modular-messaging-app directory not found."
      exit 1
    fi
    ;;
  *)
    echo "Unknown app: $APP_NAME"
    exit 1
    ;;
esac
